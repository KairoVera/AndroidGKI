+// SPDX-License-Identifier: GPL-2.0
+/*
+ * UTS (kernel release / version string) spoof extension.
+ *
+ * io-only, like cpu_spoof: handler presence is the signal. The manager
+ * (or a boot hook) sends ksu_set_spoof_version_cmd{release, version}; we
+ * rewrite the initial UTS namespace's name.release / name.version so that
+ * `uname` reports a chosen (stock-like) string. A custom kernel release
+ * string is a root-detection tell, so spoofing it hardens the stock-like
+ * posture SuStock aims for.
+ *
+ * Written against the running kernel's UTS symbols (init_uts_ns / uts_sem)
+ * so it is correct on the pinned 5.10 tree without runtime symbol
+ * resolution.
+ */
+#include <linux/kernel.h>
+#include <linux/errno.h>
+#include <linux/rwsem.h>
+#include <linux/utsname.h>
+#include <linux/uaccess.h>
+#include <linux/string.h>
+
+#include "uts_spoof.h"
+
+extern struct rw_semaphore uts_sem;
+
+int ksu_extension_uts_spoof_io(u32 id, void __user *raw)
+{
+    struct ksu_set_spoof_version_cmd cmd;
+
+    if (copy_from_user(&cmd, raw, sizeof(cmd)))
+        return -EFAULT;
+
+    cmd.release[sizeof(cmd.release) - 1] = '\0';
+    cmd.version[sizeof(cmd.version) - 1] = '\0';
+
+    if (cmd.release[0] == '\0' && cmd.version[0] == '\0')
+        return 0;
+
+    down_write(&uts_sem);
+    if (cmd.release[0] != '\0')
+        strlcpy(init_uts_ns.name.release, (const char *)cmd.release,
+                sizeof(init_uts_ns.name.release));
+    if (cmd.version[0] != '\0')
+        strlcpy(init_uts_ns.name.version, (const char *)cmd.version,
+                sizeof(init_uts_ns.name.version));
+    up_write(&uts_sem);
+
+    pr_info("ksu: uts_spoof: release=%s version=%s\n",
+            init_uts_ns.name.release, init_uts_ns.name.version);
+    return 0;
+}
