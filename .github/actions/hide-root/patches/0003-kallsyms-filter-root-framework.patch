+/* GCI root-evasion (Chunqiu detector, family 4): an unprivileged reader of
+ * /proc/kallsyms (an app's root-detection tool) can enumerate every exported
+ * kernel symbol NAME. Root / patch-framework symbols (ksu_*, sukisu,
+ * susfs_*, magisk, apatch, lspd, lsposed, kernel_su, ...) betray a patched
+ * kernel. Legit kernel symbols never contain these markers, so hiding them
+ * from non-privileged readers (privileged/CAP_SYSLOG readers keep the full
+ * table) removes the tell without touching the symbol table BPF/perf/kgdb
+ * use. String matching is done by hand so this patch needs no extra headers
+ * and stays minimal (single-region, robust across 5.10 sublevel tags). */
+static bool gci_str_contains(const char *h, const char *n)
+{
+	while (*h) {
+		const char *a = h, *b = n;
+		while (*b && *a == *b) {
+			a++;
+			b++;
+		}
+		if (!*b)
+			return true;
+		h++;
+	}
+	return false;
+}
+
+static bool kallsym_name_is_root_framework(const char *name, const char *mod)
+{
+	static const char *const markers[] = {
+		"ksu", "sukisu", "susfs", "magisk", "apatch",
+		"lspd", "lsposed", "kernel_su", "ksupm", NULL
+	};
+	int i;
+
+	for (i = 0; markers[i]; i++)
+		if (gci_str_contains(name, markers[i]))
+			return true;
+	for (i = 0; markers[i]; i++)
+		if (gci_str_contains(mod, markers[i]))
+			return true;
+	return false;
+}
